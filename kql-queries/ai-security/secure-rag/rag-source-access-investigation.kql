let RAGSecurityEvents = () {
    ContainerAppConsoleLogs_CL
    | extend evt = parse_json(Log_s)
    | where tostring(evt.schema_version) == "1.0"
    | project
        TimeGenerated,
        EventType = tostring(evt.event_type),
        Outcome = tostring(evt.outcome),
        CorrelationId = tostring(evt.correlation_id),
        UserHash = tostring(evt.user_hash),
        TenantHash = tostring(evt.tenant_hash),
        SearchIndex = tostring(evt.search_index),
        RetrievedCount = toint(evt.retrieved_count),
        GroupCount = toint(evt.group_count),
        SourceDocumentIds = evt.source_document_ids,
        ModelDeployment = tostring(evt.model_deployment),
        StatusCode = toint(evt.status_code),
        Reason = tostring(evt.reason);
};

RAGSecurityEvents()
| where EventType == "rag_query_completed"
| where TimeGenerated > ago(24h)
| mv-expand DocumentId = SourceDocumentIds
| summarize
    QueryCount=count(),
    Users=dcount(UserHash),
    CorrelationIds=make_set(CorrelationId, 20)
    by tostring(DocumentId), bin(TimeGenerated, 1h)
| order by QueryCount desc
